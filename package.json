{
  "name": "raihan-adventure-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && vite build --ssr src/prerender.tsx --outDir tmp/ssr && node tmp/ssr/prerender.js",
    "preview": "vite preview --host 127.0.0.1",
    "test": "playwright test --project=chromium",
    "pdf": "python scripts/build_pdf.py"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "motion": "^12.23.12",
    "@fontsource/silkscreen": "^5.2.7",
    "@fontsource/source-sans-3": "^5.2.8"
  },
  "devDependencies": {
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "@vitejs/plugin-react": "^5.0.3",
    "tailwindcss": "^4.1.13",
    "@tailwindcss/vite": "^4.1.13",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/node": "^22.18.6",
    "@playwright/test": "^1.55.1",
    "@axe-core/playwright": "^4.10.2",
    "lighthouse": "^13.0.0"
  }
}